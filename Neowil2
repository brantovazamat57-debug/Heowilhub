--==================================================
local coinCache = {}
local coinScanBusy = false
local farmVelocity = nil
local farmAttachment = nil
local farmNoclipConn = nil

local function refreshCoinCache()
    if coinScanBusy then return end
    coinScanBusy = true
    table.clear(coinCache)

    local char = Player.Character
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == "Coin_Server" then
            if not char or not obj:IsDescendantOf(char) then
                table.insert(coinCache, obj)
            end
        end
    end

    coinScanBusy = false
end

local function getNearestCoin()
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local nearest, nearestDist
    for _, coin in ipairs(coinCache) do
        if coin and coin.Parent then
            local dist = (hrp.Position - coin.Position).Magnitude
            if not nearestDist or dist < nearestDist then
                nearest = coin
                nearestDist = dist
            end
        end
    end
    return nearest
end

local function stopCoinFlight()
    if farmNoclipConn then
        farmNoclipConn:Disconnect()
        farmNoclipConn = nil
    end
    if farmVelocity then
        farmVelocity:Destroy()
        farmVelocity = nil
    end
    if farmAttachment then
        farmAttachment:Destroy()
        farmAttachment = nil
    end
end

local function startCoinFlight()
    stopCoinFlight()

    local char = Player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    farmAttachment = Instance.new("Attachment")
    farmAttachment.Name = "NEOWILHUB_CoinFarmAttachment"
    farmAttachment.Parent = hrp

    farmVelocity = Instance.new("LinearVelocity")
    farmVelocity.Name = "NEOWILHUB_CoinFarmVelocity"
    farmVelocity.Attachment0 = farmAttachment
    farmVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    farmVelocity.MaxForce = math.huge
    farmVelocity.VectorVelocity = Vector3.zero
    farmVelocity.Parent = hrp

    farmNoclipConn = RunService.Stepped:Connect(function()
        if not State.AutoFarmCoins then return end
        local currentChar = Player.Character
        if not currentChar then return end

        for _, part in ipairs(currentChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end

task.spawn(function()
    local lastScan = 0

    while true do
        task.wait(0.03)

        if not State.AutoFarmCoins then
            stopCoinFlight()
            continue
        end

        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            stopCoinFlight()
            continue
        end

        if not farmVelocity or not farmVelocity.Parent then
            startCoinFlight()
        end

        if tick() - lastScan >= 0.35 or #coinCache == 0 then
            refreshCoinCache()
            lastScan = tick()
        end

        local target = getNearestCoin()

        if target and target.Parent and farmVelocity then
            local targetPosition = target.Position + Vector3.new(0, 2.5, 0)
            local direction = targetPosition - hrp.Position

            if direction.Magnitude > 1.5 then
                local speed = math.clamp(45 + direction.Magnitude * 0.18, 45, 110)
                farmVelocity.VectorVelocity = direction.Unit * speed
            else
                farmVelocity.VectorVelocity = Vector3.zero
            end
        elseif farmVelocity then
            farmVelocity.VectorVelocity = Vector3.zero
        end
    end
end)

