local OriginalSky, SpaceSky = nil, nil

local function getRole(p)
    if not p or not p.Character then return nil end
    local char, bp = p.Character, p:FindFirstChild("Backpack")
    local hasKnife = char:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife"))
    local hasGun = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver")
        or (bp and (bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver")))
    if hasKnife then return "Murderer" end
    if hasGun then return "Sheriff" end
    return "Innocent"
end

local function getMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and getRole(p) == "Murderer" then return p end
    end
end

local function getSheriff()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and getRole(p) == "Sheriff" then return p end
    end
end

local function getRandomInnocent()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and getRole(p) == "Innocent" then table.insert(list, p) end
    end
    if #list == 0 then return nil end
    return list[math.random(1, #list)]
end

local function isLocalMurderer() return getRole(Player) == "Murderer" end

local function getAimPart(m)
    if not m or not m.Character then return nil end
    if State.AimHead then
        return m.Character:FindFirstChild("Head") or m.Character:FindFirstChild("HumanoidRootPart")
    elseif State.AimTorso then
        return m.Character:FindFirstChild("UpperTorso") or m.Character:FindFirstChild("Torso")
            or m.Character:FindFirstChild("HumanoidRootPart")
    else
        return m.Character:FindFirstChild("HumanoidRootPart")
    end
end

local function findMurdererInFOV()
    local m = getMurderer()
    if not m then return nil end
    local part = getAimPart(m)
    if not part then return nil end
    return m, part
end

local function teleportBehind(target)
    if not target or not target.Character or not Player.Character then return end
    local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
    local myHRP = Player.Character:FindFirstChild("HumanoidRootPart")
    if tHRP and myHRP then myHRP.CFrame = tHRP.CFrame * CFrame.new(0, 0, 3.5) end
end

local function flingSheriff()
    local s = getSheriff()
    if not s or not s.Character then return end
    local tHRP = s.Character:FindFirstChild("HumanoidRootPart")
    local tHum = s.Character:FindFirstChildOfClass("Humanoid")
    if not tHRP then return end
    if tHum then tHum.PlatformStand = true tHum.WalkSpeed = 0 tHum.JumpPower = 0 end
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(math.random(-8000,8000), math.random(8000,15000), math.random(-8000,8000))
    bv.Parent = tHRP
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(math.random(-200,200), math.random(-200,200), math.random(-200,200))
    bav.Parent = tHRP
    task.delay(5, function()
        if bv.Parent then bv:Destroy() end
        if bav.Parent then bav:Destroy() end
    end)
end

local killing = false
local function killAllAsMurderer()
    if killing or not isLocalMurderer() then return end
    killing = true
    local char = Player.Character if not char then killing = false return end
    local knife = char:FindFirstChild("Knife")
    local bp = Player:FindFirstChild("Backpack")
    if not knife and bp then
        knife = bp:FindFirstChild("Knife")
        if knife then knife.Parent = char end
    end
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    if not myHRP then killing = false return end
    local targets = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then table.insert(targets, p) end
        end
    end
    for _, t in ipairs(targets) do
        if t.Character then
            local tHRP = t.Character:FindFirstChild("HumanoidRootPart")
            if tHRP then
                myHRP.CFrame = tHRP.CFrame * CFrame.new(0,0,1.5)
                task.wait(0.02)
                if knife then pcall(function() knife:Activate() end) end
                task.wait(0.05)
            end
        end
    end
    killing = false
end

