local espCache = {}
local function createESP(p)
    if espCache[p] then return end
    local char = p.Character if not char then return end
    local hl = Instance.new("Highlight")
    hl.Name = "NEOWILHUB_ESP" hl.FillTransparency = 0.55 hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop hl.Parent = char
    espCache[p] = hl
end
local function removeESP(p) if espCache[p] then espCache[p]:Destroy() espCache[p] = nil end end
local function clearAllESP()
    for _, hl in pairs(espCache) do if hl then hl:Destroy() end end
    espCache = {}
end
local function updateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            if State.ESP then
                if not espCache[p] then createESP(p) end
                local hl = espCache[p]
                if hl then
                    local r = getRole(p)
                    if r == "Murderer" then hl.FillColor = Color3.fromRGB(255,30,30) hl.OutlineColor = Color3.fromRGB(255,0,0)
                    elseif r == "Sheriff" then hl.FillColor = Color3.fromRGB(30,120,255) hl.OutlineColor = Color3.fromRGB(0,80,255)
                    else hl.FillColor = Color3.fromRGB(30,255,80) hl.OutlineColor = Color3.fromRGB(0,200,50) end
                    hl.Enabled = true
                end
            else
                if espCache[p] then espCache[p].Enabled = false end
            end
        end
    end
end

