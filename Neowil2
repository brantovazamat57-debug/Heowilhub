local function dodgeKnifeStep()
    if not State.DodgeKnife then return end
    local m = getMurderer()
    if not m or not m.Character then return end
    local myChar = Player.Character if not myChar then return end
    local mHRP = m.Character:FindFirstChild("HumanoidRootPart")
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not mHRP or not myHRP then return end
    if not m.Character:FindFirstChild("Knife") then return end
    local dist = (mHRP.Position - myHRP.Position).Magnitude
    if dist <= State.DodgeDistance then
        local dir = (myHRP.Position - mHRP.Position)
        if dir.Magnitude < 0.1 then dir = Vector3.new(math.random(-1,1), 0, math.random(-1,1)) end
        myHRP.CFrame = CFrame.new(myHRP.Position + dir.Unit * 25)
    end
end
local function antiFlingStep()
    if not State.AntiFling then return end
    local char = Player.Character if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _, obj in ipairs(hrp:GetChildren()) do
        if obj:IsA("BodyVelocity") or obj:IsA("BodyAngularVelocity")
           or obj:IsA("BodyGyro") or obj:IsA("BodyForce") or obj:IsA("BodyThrust") then
            obj:Destroy()
        end
    end
end

