local effectCache = {}
local function setEffect(className, enabled, props)
    local name = "NEOWILHUB_" .. className
    if enabled then
        if effectCache[name] then effectCache[name]:Destroy() end
        local e = Instance.new(className)
        e.Name = name
        if props then for k, v in pairs(props) do e[k] = v end end
        e.Parent = Lighting
        effectCache[name] = e
    else
        if effectCache[name] then effectCache[name]:Destroy() effectCache[name] = nil end
    end
end

