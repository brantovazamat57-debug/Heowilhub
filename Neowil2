-- AUTO PICKUP GUN (по ChildAdded + возврат на место)
--==================================================
local pickupBusy = false

local function isGunName(name)
    local n = name:lower()
    return n == "gun" or n == "revolver" or n:find("gun") or n:find("revolver")
end

local function gunInMyInventory()
    local char = Player.Character
    local bp = Player:FindFirstChild("Backpack")
    for _, container in ipairs({char, bp}) do
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                if obj:IsA("Tool") and isGunName(obj.Name) then
                    return true
                end
            end
        end
    end
    return false
end

local function tryPickupGun(tool)
    if pickupBusy or not State.AutoPickupGun then return end
    if not tool or not tool:IsA("Tool") or not isGunName(tool.Name) then return end
    if gunInMyInventory() then return end

    pickupBusy = true

    task.spawn(function()
        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then pickupBusy = false return end

        local handle = tool:FindFirstChild("Handle")
        if not handle then pickupBusy = false return end

        local savedCFrame = hrp.CFrame

        -- Телепорт прямо в Handle, чтобы сработал Touched
        for i = 1, 20 do
            if gunInMyInventory() then break end
            if not tool.Parent or not handle.Parent then break end
            hrp.CFrame = handle.CFrame
            task.wait(0.05)
        end

        -- Форс, если Touched не сработал
        if not gunInMyInventory() and tool.Parent then
            pcall(function() hum:EquipTool(tool) end)
            task.wait(0.1)
            if not gunInMyInventory() and tool.Parent then
                pcall(function() tool.Parent = char end)
            end
        end

        -- Возврат на исходную позицию
        task.wait(0.1)
        if hrp and hrp.Parent then
            hrp.CFrame = savedCFrame
        end

        pickupBusy = false
    end)
end

