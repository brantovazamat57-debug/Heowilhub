local skyboxBusy = false
local function applySkybox(name)
    if skyboxBusy then return end
    skyboxBusy = true
    if SpaceSky then SpaceSky:Destroy() SpaceSky = nil end
    if not OriginalSky then OriginalSky = Lighting:FindFirstChildOfClass("Sky") end
    if name == "Default" then
        if OriginalSky then OriginalSky.Parent = Lighting end
        Lighting.ClockTime = 14
        task.delay(0.4, function() skyboxBusy = false end)
        return
    end
    local preset = SKYBOXES[name]
    if not preset then skyboxBusy = false return end
    for _, c in ipairs(Lighting:GetChildren()) do
        if c:IsA("Sky") and c.Name == "NEOWILHUB_Sky" then c:Destroy() end
    end
    if OriginalSky then OriginalSky.Parent = nil end
    SpaceSky = Instance.new("Sky")
    SpaceSky.Name = "NEOWILHUB_Sky"
    SpaceSky.SkyboxBk = preset.Bk SpaceSky.SkyboxDn = preset.Dn
    SpaceSky.SkyboxFt = preset.Ft SpaceSky.SkyboxLf = preset.Lf
    SpaceSky.SkyboxRt = preset.Rt SpaceSky.SkyboxUp = preset.Up
    if preset.StarCount then SpaceSky.StarCount = preset.StarCount end
    SpaceSky.Parent = Lighting
    if preset.ClockTime then Lighting.ClockTime = preset.ClockTime end
    task.delay(0.3, function() skyboxBusy = false end)
end

