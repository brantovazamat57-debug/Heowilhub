RunService.RenderStepped:Connect(function(dt)
    updateESP()
    applySpeedGlitch()
    dodgeKnifeStep()
    antiFlingStep()
    checkJumpEffect()

    if State.AimLock then
        local m = getMurderer()
        if m and m.Character then
            local part = getAimPart(m)
            if part then Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position) end
        end
    end

    if State.AimbotMurderer then
        local m, part = findMurdererInFOV()
        if m and part then
            local targetCF = CFrame.new(Camera.CFrame.Position, part.Position)
            local alpha = math.min(dt * 15, 1)
            Camera.CFrame = Camera.CFrame:Lerp(targetCF, alpha)
        end
    end
    if State.CamDistanceEnabled then Player.CameraMaxZoomDistance = State.CamDistanceValue end
end)

